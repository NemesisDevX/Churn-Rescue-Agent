# CALL-E Developer API credentials
# Get your key from https://heycall-e.com/ or the hackathon dashboard.
CALLE_API_KEY=your_call_e_api_key_here
CALLE_BASE_URL=https://api.heycall-e.com

# Optional: public URL where CALL-E should POST terminal call events.
# Useful for ngrok / cloud run / local tunnels.
CALLE_WEBHOOK_URL=

# Twilio credentials for WhatsApp confirmations
# To use the Twilio Sandbox for WhatsApp, your customer must have sent the
# join code to the sandbox number first.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Format must be `whatsapp:+<E.164>`, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# App behavior
APP_ENV=development
LOG_LEVEL=INFO

# SQLite mock CRM path
DATABASE_PATH=data/churn_rescue.db

# Dynamic discount formula:
#   discount = min(discount_max_percent,
#                  discount_min_percent + (ltv // ltv_tier_step) * discount_step_percent)
DISCOUNT_MIN_PERCENT=20
DISCOUNT_MAX_PERCENT=50
DISCOUNT_STEP_PERCENT=5
LTV_TIER_STEP=500

# HTTP / polling
CALL_TIMEOUT_SECONDS=30
CALL_POLL_INTERVAL_SECONDS=5
CALL_MAX_POLL_SECONDS=300
